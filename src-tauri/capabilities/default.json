{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions for FocusFlow.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DESKTOP/**/*",
        "$DOCUMENT/**/*",
        "$DOWNLOAD/**/*",
        "$HOME/*.json"
      ]
    }
  ]
}
